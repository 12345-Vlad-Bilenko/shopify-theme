<!-- ХЕДЕР -->
<div class="custom-header-bar">

  <!-- ЛІВА ЧАСТИНА: Контакти та зворотній дзвінок -->
  <div class="header-left">
    <div class="header-contacts">
      <a href="#" class="dropdown-toggle">
        +380639995858 <span class="arrow">▼</span>
      </a>
      <ul class="dropdown-list">
        <li>
          <a href="tel:+380684456956">+380684456956</a>
        </li>
        <li>
          <a href="tel:0800357222">0 800 357 222</a>
        </li>
      </ul>
    </div>

    <div class="callback-header">
      <a href="#" onclick="openCallbackPopup()">
        <span class="callback-title">Зворотній дзвінок</span>
      </a>
    </div>
  </div>

  <!-- ЦЕНТРАЛЬНА ЧАСТИНА: Логотип -->
  <div class="header-center">
    <a href="{{ routes.root_url }}">
      <img src="{{ 'logo_vinnitsakristall_header.png' | asset_url }}" alt="Логотип" style="height: 50px;">
    </a>
  </div>

  <!-- ПРАВА ЧАСТИНА: Пошук та корзина -->
  <div class="header-right">
    <div class="custom-header-tools">
      <div class="custom-search-placeholder">
        <span>Пошук (у розробці)</span>
      </div>
      <div class="custom-cart-placeholder">
        <img src="{{ 'logo_vinnitsakristall_cart.png' | asset_url }}" alt="Корзина" style="height: 32px;">
      </div>
    </div>
  </div>

</div>

<!-- POPUP -->
<div id="callback-popup" class="callback-popup">
  <div class="popup-inner">
    <h2>Зворотній дзвінок</h2>
    <p>Залиште свій номер телефону та ім’я — ми зателефонуємо.</p>
    <form action="https://vinnitsakristall.com/customercallbacks/index/callback/" method="post">
      <label for="name">Ваше ім’я</label>
      <input type="text" name="name" required>

      <label for="phone">Телефон</label>
      <input type="tel" name="phone" required>

      <button type="submit" class="btn-submit">Відправити</button>
    </form>
    <button onclick="closeCallbackPopup()" class="btn-close">Закрити</button>
  </div>
</div>
