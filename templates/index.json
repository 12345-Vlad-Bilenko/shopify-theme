    "custom_liquid_jtXHpq": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  Карусель блогів — тільки зображення\n  Додається через Theme Editor → Add block → Custom Liquid\n{% endcomment %}\n\n{% assign blog_handle = 'news' %}\n{% assign articles_limit = 5 %}\n\n{% if blogs[blog_handle].articles.size > 0 %}\n<div class=\"blog-section\">\n  <h2 class=\"blog-section-title\">Новини та акції</h2>\n\n  <div class=\"blog-carousel-container\">\n    <button class=\"carousel-btn prev-btn\" aria-label=\"Попередній слайд\">&#10094;</button>\n    \n    <div class=\"blog-carousel\" id=\"blog-carousel\">\n      {% for article in blogs[blog_handle].articles limit: articles_limit %}\n        {% if article.image %}\n        <div class=\"carousel-slide\">\n          <a href=\"{{ article.url }}\">\n            <img \n              src=\"{{ article.image.src | img_url: '600x' }}\" \n              alt=\"{{ article.image.alt | escape }}\" \n              loading=\"lazy\"\n              width=\"600\"\n              height=\"{{ 600 | divided_by: article.image.aspect_ratio | round }}\"\n            >\n          </a>\n        </div>\n        {% endif %}\n      {% endfor %}\n    </div>\n\n    <button class=\"carousel-btn next-btn\" aria-label=\"Наступний слайд\">&#10095;</button>\n  </div>\n</div>\n\n<style>\n  .blog-section {\n    background-image: url({{ 'blog_bg.png' | asset_url }}); /* заміни jpg на png при потребі */\n    background-size: cover;\n    background-position: center;\n    padding: 60px 20px;\n  }\n\n  .blog-section-title {\n    text-align: center;\n    font-size: 32px;\n    margin-bottom: 40px;\n    color: #fff;\n  }\n\n  .blog-carousel-container {\n    position: relative;\n    max-width: 1200px;\n    margin: 0 auto;\n    overflow: hidden;\n  }\n\n  .blog-carousel {\n    display: flex;\n    gap: 20px;\n    transition: transform 0.5s ease-in-out;\n    scroll-behavior: smooth;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n  }\n\n  .carousel-slide {\n    flex: 0 0 calc(33.333% - 20px);\n    scroll-snap-align: start;\n  }\n\n  .carousel-slide img {\n    width: 100%;\n    height: auto;\n    border-radius: 10px;\n    display: block;\n  }\n\n  .carousel-btn {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    background: rgba(0,0,0,0.5);\n    color: #fff;\n    border: none;\n    font-size: 24px;\n    padding: 12px 16px;\n    cursor: pointer;\n    z-index: 2;\n  }\n\n  .prev-btn {\n    left: 0;\n  }\n\n  .next-btn {\n    right: 0;\n  }\n\n  .carousel-btn:hover {\n    background: rgba(0,0,0,0.7);\n  }\n\n  @media (max-width: 900px) {\n    .carousel-slide {\n      flex: 0 0 50%;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .carousel-slide {\n      flex: 0 0 100%;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const carousel = document.getElementById('blog-carousel');\n    const slideWidth = carousel.querySelector('.carousel-slide').offsetWidth + 20;\n\n    document.querySelector('.next-btn').addEventListener('click', () => {\n      carousel.scrollBy({ left: slideWidth, behavior: 'smooth' });\n    });\n\n    document.querySelector('.prev-btn').addEventListener('click', () => {\n      carousel.scrollBy({ left: -slideWidth, behavior: 'smooth' });\n    });\n  });\n</script>\n{% else %}\n<p class=\"no-articles\">Наразі немає доступних статей.</p>\n<style>\n  .no-articles {\n    text-align: center;\n    padding: 40px;\n    color: #666;\n  }\n</style>\n{% endif %}",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
